{
  "name": "kitchen-wall-render",
  "private": true,
  "type": "module",
  "description": "Draws the kitchen wall screen from a Google Calendar feed, the weekly menu, the weather and a photo folder.",
  "scripts": {
    "render": "node render.mjs",
    "sample": "WALL_CALENDAR_FILE=test/sample.ics NOW=2026-11-04T16:10:00-07:00 OUT=../out node render.mjs"
  },
  "dependencies": {
    "googleapis": "144.0.0",
    "ical-expander": "3.1.0",
    "playwright": "1.49.1",
    "sharp": "0.33.5"
  },
  "engines": {
    "node": ">=20"
  }
}
